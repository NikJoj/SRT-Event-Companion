<Window x:Class="Srt.EventCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRT Event Companion"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1120" Height="760" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>

    <!-- ═══ BRAND HEADER ═══ -->
    <Border Grid.Row="0" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="pack://application:,,,/Assets/srt-labs-logo.png" Height="42" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" ToolTip="SRT Labs"/>
        <Border Grid.Column="1" Width="1" Height="32" Background="{StaticResource LineStrong}" Margin="20,0"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="SRT EVENT COMPANION" FontFamily="{StaticResource DisplayFont}" FontSize="28" Foreground="{StaticResource Text}"/>
          <TextBlock x:Name="HeaderKicker" Text="SIM RACING THARAVADU" Style="{StaticResource Kicker}" FontSize="12" Margin="0,-4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UpdateBtn" Visibility="Collapsed" Style="{StaticResource PrimaryBtn}" FontSize="14" Padding="18,8"
                  Margin="0,0,22,0" VerticalAlignment="Center" Click="InstallUpdate_Click"
                  ToolTip="A newer version was published by SRT. Installing takes about a minute and reopens the app."/>
          <Button x:Name="SettingsBtn" Content="⚙  SETTINGS" Style="{StaticResource SecondaryBtn}" FontSize="13" Padding="14,6"
                  Margin="0,0,22,0" VerticalAlignment="Center" Click="Settings_Click"
                  ToolTip="Sim centre or own PC, start with Windows, automatic updates"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="RigLabelCaption" Text="RIG" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" Margin="0"/>
            <TextBlock x:Name="RigLabel" Text="Not paired" HorizontalAlignment="Right"
                       FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource Text}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ STEPS (one visible at a time) ═══ -->
    <Grid Grid.Row="1">
      <!-- soft red glow, like the site hero -->
      <Grid.Background>
        <RadialGradientBrush Center="0.88,0.35" GradientOrigin="0.88,0.35" RadiusX="0.55" RadiusY="0.8">
          <GradientStop Color="#2A0A10" Offset="0"/>
          <GradientStop Color="#080A0C" Offset="1"/>
        </RadialGradientBrush>
      </Grid.Background>

      <!-- ── STEP 1: RIG CHECK ── -->
      <Grid x:Name="StepInit" Visibility="Visible">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
          <TextBlock Text="GET READY" Style="{StaticResource Kicker}"/>
          <TextBlock Text="CHOOSE YOUR EVENT" Style="{StaticResource StepHeading}"/>
          <TextBlock x:Name="InitHint" Style="{StaticResource Hint}" Margin="0,0,0,18"
                     Text="Pick the event to race in. The app uses that event's server and installs the mods it needs."/>

          <!-- Every live event; each has its own server and required mods. -->
          <Grid Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Padding="0,10,0,6">
              <StackPanel>
                <Grid Margin="22,0,14,6">
                  <TextBlock Text="LIVE EVENTS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                  <Button x:Name="RefreshEventsBtn" Content="REFRESH" Style="{StaticResource SecondaryBtn}" FontSize="12" Padding="12,4"
                          HorizontalAlignment="Right" Click="RefreshEvents_Click"/>
                </Grid>
                <ListBox x:Name="EventList" Background="Transparent" BorderThickness="0" MaxHeight="230"
                         ItemContainerStyle="{StaticResource DarkListItem}" SelectionChanged="EventList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <TextBlock x:Name="EventStatus" Style="{StaticResource Hint}" Margin="22,6,22,6" Text="Loading live events…"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardAccent}"/>
          </Grid>

          <TextBlock Text="PC CHECK" Style="{StaticResource FieldLabel}"/>

          <Grid Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Padding="22,10">
              <StackPanel>
                <Grid Height="46">
                  <TextBlock x:Name="StatusRigLabel" Text="Rig registration" Style="{StaticResource StatusLabel}"/>
                  <TextBlock x:Name="StatusRig" Text="Checking…" Style="{StaticResource StatusValue}"/>
                </Grid>
                <Border Height="1" Background="{StaticResource Line}"/>
                <Grid Height="46">
                  <TextBlock Text="Assetto Corsa installation" Style="{StaticResource StatusLabel}"/>
                  <TextBlock x:Name="StatusAC" Text="Checking…" Style="{StaticResource StatusValue}"/>
                </Grid>
                <Border Height="1" Background="{StaticResource Line}"/>
                <Grid Height="46">
                  <TextBlock Text="Steam account" Style="{StaticResource StatusLabel}"/>
                  <TextBlock x:Name="StatusSteam" Text="Checking…" Style="{StaticResource StatusValue}"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardAccent}"/>
          </Grid>

          <TextBlock x:Name="InitError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>

          <!-- Shown when Assetto Corsa can't be found automatically: staff pick the folders themselves. -->
          <Grid x:Name="AcPickPanel" Visibility="Collapsed" Margin="0,4,0,14">
            <Border Style="{StaticResource Card}" Padding="22,16">
              <StackPanel>
                <TextBlock Text="SET ASSETTO CORSA FOLDERS" Style="{StaticResource CardHeading}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,12" TextWrapping="Wrap"
                           Text="Couldn't find them automatically? Choose them here. The app remembers them on this PC."/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="1 · GAME FOLDER (contains AssettoCorsa.exe)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="AcGameFolderText" Text="Not set" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="To find it: in Steam, right-click Assetto Corsa → Manage → Browse local files. Pick the folder that opens. It usually ends in steamapps\common\assettocorsa, for example D:\SteamLibrary\steamapps\common\assettocorsa."/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="CHOOSE GAME FOLDER…" Style="{StaticResource SecondaryBtn}"
                          VerticalAlignment="Top" Click="ChooseGameFolder_Click"/>
                </Grid>

                <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="2 · SETTINGS FOLDER (contains cfg\race.ini)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="AcSettingsFolderText" Text="Not set" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="This is the Assetto Corsa folder inside Documents (it may be under OneDrive\Documents). If it doesn't exist, start AC once through Content Manager, close it, then select CHECK AGAIN."/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="CHOOSE SETTINGS FOLDER…" Style="{StaticResource SecondaryBtn}"
                          VerticalAlignment="Top" Click="ChooseSettingsFolder_Click"/>
                </Grid>

                <TextBlock x:Name="AcPickError" Style="{StaticResource ErrorText}" Visibility="Collapsed" Margin="0,12,0,0"/>
                <Button x:Name="AcResetBtn" Content="FORGET CHOSEN FOLDERS" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left"
                        Margin="0,12,0,0" Visibility="Collapsed" Click="ResetAcFolders_Click"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardAccent}"/>
          </Grid>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="CHECK AGAIN" Style="{StaticResource SecondaryBtn}" Click="CheckAgain_Click" Margin="0,0,8,0"/>
            <Button x:Name="PairBtn" Content="PAIR THIS RIG" Style="{StaticResource SecondaryBtn}" Click="PairRig_Click" Margin="0,0,8,0"/>
            <Button x:Name="PrepareBtn" Content="PREPARE FOR EVENT" Style="{StaticResource PrimaryBtn}" Click="PrepareForEvent_Click" Margin="0,0,8,0"
                    ToolTip="Install the chosen event's mods on this PC." IsEnabled="False"/>
            <Button x:Name="ProceedBtn" Content="CONTINUE  →" Style="{StaticResource PrimaryBtn}" Click="Proceed_Click" IsEnabled="False"/>
          </StackPanel>
          <TextBlock x:Name="PrepareHint" Style="{StaticResource Hint}" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed"
                     Text="Select Prepare for event to install this event's mods. Continue unlocks when it turns green."/>
        </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ── STEP 2: DRIVER (left: pick / details · right: raced at this centre) ── -->
      <Grid x:Name="StepDriver" Visibility="Collapsed" Margin="36,26,36,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*"/>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
              <TextBlock Text="DRIVER" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="DriverHeading" Text="WHO'S DRIVING?" Style="{StaticResource StepHeading}"/>
              <TextBlock x:Name="DriverHint" Style="{StaticResource Hint}" Margin="0,0,0,20"
                         Text="The driver signs in with their email. SRT emails them a 6-digit code, and only a driver who enters the right code can race."/>
              <TextBlock x:Name="DriverStatus" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,0,0,14"/>

              <StackPanel x:Name="EmailPanel">
                <TextBlock Text="DRIVER'S EMAIL" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="EmailInput" Style="{StaticResource Field}" Margin="0" MaxLength="254" KeyDown="EmailInput_KeyDown"/>
                  <Button x:Name="SendCodeBtn" Grid.Column="1" Content="SEND CODE" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="SendCodeBtn_Click"/>
                </Grid>
                <TextBlock x:Name="EmailNotice" Style="{StaticResource Hint}" Margin="0,0,0,14"
                           Text="Your email is only used to verify your identity. We will not use it for anything else."/>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                             Text="Or sign in with Discord: the driver scans a QR code with their phone. Any Discord account works; new drivers get an SRT profile."/>
                  <Button x:Name="DiscordSignInBtn" Grid.Column="1" Content="SIGN IN WITH DISCORD" Style="{StaticResource SecondaryBtn}"
                          Margin="12,0,0,0" Click="DiscordSignIn_Click"/>
                </Grid>
              </StackPanel>

              <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                <TextBlock Text="6-DIGIT CODE FROM THE EMAIL" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="CodeInput" Style="{StaticResource Field}" Margin="0" MaxLength="7" KeyDown="CodeInput_KeyDown"/>
                  <Button x:Name="VerifyCodeBtn" Grid.Column="1" Content="VERIFY" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Click="VerifyCode_Click"/>
                  <Button x:Name="ResendCodeBtn" Grid.Column="2" Content="RESEND" Style="{StaticResource SecondaryBtn}" Margin="2,0,0,0" Click="ResendCode_Click"/>
                </Grid>
                <TextBlock x:Name="CodeStatus" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
              </StackPanel>

              <Grid x:Name="DriverPanel" Visibility="Collapsed" Margin="0,8,0,18">
                <Border Style="{StaticResource Card}" Padding="18,16">
                  <StackPanel>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="DriverPanelTitle" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                 Foreground="{StaticResource Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <Button x:Name="ChangeDriverBtn" Grid.Column="1" Content="CHANGE DRIVER" Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0" Click="ChangeDriver_Click"/>
                    </Grid>
                    <TextBlock x:Name="DriverPanelHint" Style="{StaticResource Hint}"/>
                    <!-- Discord: shown once linked, otherwise an optional Link button -->
                    <Grid x:Name="DiscordRow" Margin="0,10,0,0" Visibility="Collapsed">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="DiscordStatus" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                      <Button x:Name="LinkDiscordBtn" Grid.Column="1" Content="LINK DISCORD" Style="{StaticResource SecondaryBtn}"
                              Margin="10,0,0,0" Click="LinkDiscord_Click" ToolTip="Optional. Lets the driver sign in with Discord next time, and joins their SRT race history."/>
                    </Grid>
                    <StackPanel x:Name="NewProfilePanel" Visibility="Collapsed" Margin="0,14,0,0">
                      <TextBlock Text="NAME ON THE LEADERBOARD" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="LeaderboardNameInput" Style="{StaticResource Field}" MaxLength="64" TextChanged="LeaderboardName_TextChanged"/>
                      <TextBlock Style="{StaticResource Hint}" Text="First time with this email. Ask the driver for the name to show on the SRT leaderboard."/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardAccent}"/>
              </Grid>

              <StackPanel x:Name="InGamePanel" Visibility="Collapsed">
                <TextBlock Text="IN-GAME DISPLAY NAME  (SHOWN ON THE SERVER)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DisplayNameInput" Style="{StaticResource Field}"/>
              </StackPanel>

              <TextBlock x:Name="DriverError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="←  BACK" Style="{StaticResource SecondaryBtn}" Click="BackToInit_Click" Margin="0,0,8,0"/>
            <Button x:Name="PreviewBtn" Content="PREVIEW  →" Style="{StaticResource PrimaryBtn}" Click="PreviewJoin_Click"/>
          </StackPanel>
        </Grid>

        <!-- Right: how email sign-in works, for staff and drivers (sim centres only) -->
        <Grid x:Name="SignInHelpCard" Grid.Column="2">
          <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
              <TextBlock Text="HOW SIGN-IN WORKS" Style="{StaticResource CardHeading}"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="1.  Type the driver's email and select Send code."/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="2.  The driver opens the email on their phone and reads out the 6-digit code. It works for 10 minutes."/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="3.  First time with this email? Enter the name to show on the leaderboard."/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="4.  Optional: Link Discord. Next time the driver can sign in with Discord instead of waiting for an email."/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="5.  Preview, then Launch. Each sign-in is good for one session."/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0"
                         Text="Prefer Discord? Select Sign in with Discord and let the driver scan the QR code with their phone. SRT drivers who signed in on the website with Discord get their existing profile."/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0"
                         Text="No email? Check the spam and promotions folders, wait a minute, then select Resend. Five wrong codes means sending a new one."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardAccent}"/>
        </Grid>
      </Grid>

      <!-- ── STEP 3: SESSION (left: details, password · right: lap times) ── -->
      <Grid x:Name="StepLaunch" Visibility="Collapsed" Margin="36,26,36,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*"/>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
              <TextBlock Text="SESSION" Style="{StaticResource Kicker}"/>
              <TextBlock x:Name="LaunchHeading" Text="READY TO LAUNCH" Style="{StaticResource StepHeading}"/>
              <TextBlock x:Name="LaunchHint" Style="{StaticResource Hint}" Margin="0,0,0,18"
                         Text="Review the details below, then launch Content Manager to begin the session."/>

              <Border x:Name="PasswordPanel" Visibility="Collapsed" Background="#17120A" BorderBrush="{StaticResource Gold}"
                      BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="SERVER PASSWORD" Style="{StaticResource FieldLabel}" Foreground="{StaticResource Gold}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PasswordText" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="White" FontSize="28" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="COPY" Style="{StaticResource SecondaryBtn}" Click="CopyPassword_Click"/>
                  </Grid>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                             Text="Content Manager asks for this when joining. Type or paste it there."/>
                </StackPanel>
              </Border>

              <Grid Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Padding="18,14">
                  <StackPanel>
                    <TextBlock Text="SESSION DETAILS" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PreviewOutput" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                             Foreground="#C9CED6" BorderThickness="0" FontSize="13" FontFamily="{StaticResource MonoFont}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardAccent}"/>
              </Grid>

              <TextBlock x:Name="SyncStatus" Style="{StaticResource Hint}" FontFamily="{StaticResource BodySemiFont}" Margin="0,0,0,8"/>
              <TextBlock x:Name="LaunchError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="EditDriverBtn" Content="←  EDIT DRIVER" Style="{StaticResource SecondaryBtn}" Click="BackToDriver_Click" Margin="0,0,8,0"/>
            <Button x:Name="EndSessionBtn" Content="END SESSION &amp; RESTORE" Style="{StaticResource PrimaryBtn}" Click="EndSession_Click" Margin="0,0,8,0"/>
            <Button x:Name="LaunchBtn" Content="LAUNCH CONTENT MANAGER" Style="{StaticResource PrimaryBtn}" Click="Launch_Click"/>
          </StackPanel>
        </Grid>

        <!-- Right: live lap times -->
        <Grid Grid.Column="2">
          <Border Style="{StaticResource Card}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="LAP TIMES" Style="{StaticResource CardHeading}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
              <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="30,4,30,0"
                         Text="Lap times appear here once the session starts and the driver is on track."/>
            </StackPanel>
          </Border>
          <Border x:Name="LapPanel" Visibility="Collapsed" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid>
                <TextBlock Text="LAP TIMES" Style="{StaticResource CardHeading}"/>
                <TextBlock x:Name="LapStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="{StaticResource CondensedFont}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Muted}"/>
              </Grid>
              <TextBlock x:Name="LapSummary" Grid.Row="1" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                         Foreground="{StaticResource Text}" Margin="0,10,0,10"/>
              <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="LapList" FontSize="15" FontFamily="{StaticResource MonoFont}" Foreground="#C9CED6"
                             TextWrapping="Wrap" LineHeight="26"/>
                </ScrollViewer>
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource CardAccent}"/>
        </Grid>
      </Grid>

      <!-- ── PAGES: setup, settings, pairing, Discord and event mods open here, over the current step (Esc goes back) ── -->
      <Grid x:Name="PageHost" Visibility="Collapsed" Background="#F2080A0C">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
            <ContentControl x:Name="PageContent" Focusable="False"/>
          </Border>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ═══ FOOTER ═══ -->
    <Border Grid.Row="2" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="28,0">
        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource CondensedFont}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Muted}">
          <Run Text="SRT EVENT COMPANION"/><Run Text="  ·  BY " /><Run Text="SRT LABS" Foreground="{StaticResource Gold}"/>
        </TextBlock>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource CondensedFont}" FontWeight="Bold"
                   FontSize="12" Foreground="{StaticResource Muted}">
          <Run x:Name="VersionText" Text="V0.0.0"/><Run Text="  ·  SIMRACINGTHARAVADU.IN"/>
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</Window>
