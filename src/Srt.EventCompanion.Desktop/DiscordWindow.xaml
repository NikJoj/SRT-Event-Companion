<local:PageView x:Class="Srt.EventCompanion.Desktop.DiscordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Srt.EventCompanion.Desktop"
        Width="600" Background="{StaticResource Bg2}" Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Grid>
    <Border Style="{StaticResource CardAccent}"/>
    <StackPanel Margin="32,30,32,28">
      <TextBlock Text="DISCORD" Style="{StaticResource Kicker}"/>
      <TextBlock x:Name="Heading" Text="LINK DISCORD" Style="{StaticResource StepHeading}" FontSize="38"/>
      <TextBlock x:Name="IntroText" Style="{StaticResource Hint}" Margin="0,0,0,18"/>

      <!-- Waiting: QR code for the phone, the code and link as text, or open here -->
      <Grid x:Name="WaitPanel">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="White" Padding="10" Width="200" Height="200" VerticalAlignment="Top">
          <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="22,0,0,0">
          <TextBlock Text="1 · SCAN WITH YOUR PHONE CAMERA" Style="{StaticResource FieldLabel}"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="Sign in to Discord on the page that opens. Your phone keeps you signed in, not this PC."/>
          <TextBlock Text="2 · OR OPEN IT ON THIS PC" Style="{StaticResource FieldLabel}"/>
          <Button x:Name="OpenHereBtn" Content="OPEN IN BROWSER" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" Click="OpenHere_Click"/>
          <TextBlock x:Name="SharedPcHint" Style="{StaticResource Hint}" Margin="0,6,0,0" Foreground="{StaticResource Gold}" Visibility="Collapsed"
                     Text="On a shared rig, sign out of Discord in the browser afterwards."/>
        </StackPanel>
      </Grid>

      <!-- Finished: what happened, and the SRT Discord server -->
      <StackPanel x:Name="DonePanel" Visibility="Collapsed">
        <TextBlock x:Name="DoneTitle" FontFamily="{StaticResource DisplayFont}" FontSize="28" TextWrapping="Wrap"/>
        <TextBlock x:Name="DoneText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        <Border x:Name="JoinPanel" Background="#141836" BorderBrush="#5865F2" BorderThickness="1" Padding="16,14" Margin="0,16,0,0" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="JoinTitle" Text="JOIN THE SIM RACING THARAVADU DISCORD" FontFamily="{StaticResource CondensedFont}" FontWeight="Bold" FontSize="15"/>
            <TextBlock x:Name="JoinText" Style="{StaticResource Hint}" Margin="0,4,0,10"
                       Text="Event news, entry lists, results and race-day chat all happen there."/>
            <Button x:Name="JoinBtn" Content="JOIN THE SRT DISCORD" Style="{StaticResource PrimaryBtn}" Background="#5865F2" BorderBrush="#5865F2"
                    HorizontalAlignment="Left" Click="Join_Click"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
      <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" Margin="0,12,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="RetryBtn" Content="START AGAIN" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Visibility="Collapsed" Click="Retry_Click"/>
        <Button x:Name="CloseBtn" Content="CANCEL" Style="{StaticResource SecondaryBtn}" Click="Close_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</local:PageView>
