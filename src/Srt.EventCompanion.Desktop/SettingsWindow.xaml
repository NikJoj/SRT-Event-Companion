<Window x:Class="Srt.EventCompanion.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings · SRT Event Companion" Icon="pack://application:,,,/Assets/app.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg2}" Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Grid>
    <Border Style="{StaticResource CardAccent}"/>
    <StackPanel Margin="32,30,32,28">
      <TextBlock Text="SRT EVENT COMPANION" Style="{StaticResource Kicker}"/>
      <TextBlock Text="SETTINGS" Style="{StaticResource StepHeading}" FontSize="38"/>

      <TextBlock Text="THIS PC" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="ModeText" FontFamily="{StaticResource DisplayFont}" FontSize="24"/>
          <TextBlock x:Name="ModeDetail" Style="{StaticResource Hint}"/>
        </StackPanel>
        <Button x:Name="ChangeModeBtn" Grid.Column="1" Content="CHANGE…" Style="{StaticResource SecondaryBtn}" VerticalAlignment="Top"
                Click="ChangeMode_Click" ToolTip="Switch between a sim centre rig and your own PC."/>
      </Grid>

      <!-- Own PC only: link Discord to the signed-in driver -->
      <StackPanel x:Name="DiscordSection" Visibility="Collapsed" Margin="0,0,0,20">
        <TextBlock Text="DISCORD" Style="{StaticResource FieldLabel}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DiscordText" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
          <Button x:Name="LinkDiscordBtn" Grid.Column="1" Content="LINK DISCORD" Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0" Click="LinkDiscord_Click"/>
        </Grid>
      </StackPanel>

      <TextBlock Text="APP" Style="{StaticResource FieldLabel}"/>
      <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource Toggle}" Content="Start with Windows"/>
      <TextBlock Style="{StaticResource Hint}" Margin="32,0,0,12" Text="Opens the app when you sign in to Windows."/>
      <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource Toggle}" Content="Install updates automatically"/>
      <TextBlock Style="{StaticResource Hint}" Margin="32,0,0,18" Text="New versions install between sessions, never during one. When off, an Update button appears at the top when a new version is out."/>

      <TextBlock x:Name="SettingsError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="CANCEL" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" IsCancel="True"/>
        <Button Content="SAVE" Style="{StaticResource PrimaryBtn}" IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
