<Window x:Class="Srt.EventCompanion.Desktop.PairRigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair this rig · SRT Event Companion" Icon="pack://application:,,,/Assets/app.ico"
        Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg2}" Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Grid>
    <Border Style="{StaticResource CardAccent}"/>
    <StackPanel Margin="32,30,32,28">
      <TextBlock Text="RIG SETUP" Style="{StaticResource Kicker}"/>
      <TextBlock Text="PAIR THIS RIG" Style="{StaticResource StepHeading}" FontSize="38"/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,22"
                 Text="Enter the code from SRT admin (Kerala Race Wars → Rigs → Pair). Codes last 10 minutes and work once. Steam must be signed in to this rig's registered account."/>

      <TextBlock Text="PAIRING CODE" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="CodeInput" Style="{StaticResource Field}" FontFamily="{StaticResource MonoFont}" FontSize="22"
               Padding="14,10" CharacterCasing="Upper" KeyDown="CodeInput_KeyDown"/>

      <!-- What went wrong and what to do; always shown when pairing fails -->
      <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#1E0C10" BorderBrush="{StaticResource Danger}"
              BorderThickness="3,0,0,0" Padding="16,12" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock x:Name="ErrorProblem" FontFamily="{StaticResource BodySemiFont}" FontSize="14" Foreground="#FFB4BC" TextWrapping="Wrap"/>
          <TextBlock x:Name="ErrorNextStep" FontSize="13" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock x:Name="ErrorSupport" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusOutput" Visibility="Collapsed" Style="{StaticResource Hint}" Margin="0,0,0,16"/>

      <Button x:Name="PairButton" Content="COMPLETE PAIRING" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Click="Pair_Click"/>
    </StackPanel>
  </Grid>
</Window>
