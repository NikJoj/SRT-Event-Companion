<local:PageView x:Class="Srt.EventCompanion.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Srt.EventCompanion.Desktop"
        Width="640" Background="{StaticResource Bg2}" Foreground="{StaticResource Text}" FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Grid>
    <Border Style="{StaticResource CardAccent}"/>

    <!-- ── Page 1: how this PC is used, and the two app options ── -->
    <StackPanel x:Name="ModePage" Margin="34,30,34,28">
      <TextBlock x:Name="ModeKicker" Text="WELCOME" Style="{StaticResource Kicker}"/>
      <TextBlock Text="HOW WILL YOU USE THIS APP?" Style="{StaticResource StepHeading}" FontSize="38"/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                 Text="SRT Event Companion gets your PC ready for an SRT event: it sets your driver name, installs the event's mods and joins the server."/>

      <RadioButton x:Name="CentreChoice" GroupName="Mode" Style="{StaticResource ChoiceCard}" Margin="0,0,0,10" Checked="Mode_Checked">
        <StackPanel>
          <TextBlock Text="AT A SIM CENTRE" FontFamily="{StaticResource DisplayFont}" FontSize="26"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                     Text="This PC is a rig at a sim centre. Staff pair it once with a code from SRT, and each driver signs in with their email before their session."/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="IndividualChoice" GroupName="Mode" Style="{StaticResource ChoiceCard}" Margin="0,0,0,20" Checked="Mode_Checked">
        <StackPanel>
          <TextBlock Text="ON MY OWN PC" FontFamily="{StaticResource DisplayFont}" FontSize="26"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                     Text="You race from your own PC. Sign in once with your email; every session on this PC is yours. No pairing code needed."/>
        </StackPanel>
      </RadioButton>

      <TextBlock Text="OPTIONS  (YOU CAN CHANGE THESE LATER IN SETTINGS)" Style="{StaticResource FieldLabel}"/>
      <CheckBox x:Name="StartWithWindowsBox" Style="{StaticResource Toggle}" Content="Start with Windows"/>
      <TextBlock Style="{StaticResource Hint}" Margin="32,0,0,12" Text="Opens the app when you sign in to Windows. Handy on a rig; usually not needed on a home PC."/>
      <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource Toggle}" Content="Install updates automatically"/>
      <TextBlock Style="{StaticResource Hint}" Margin="32,0,0,18" Text="New versions install between sessions, never during one. Turn off to update only when you click Update."/>

      <TextBlock x:Name="ModeError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelBtn" Content="CANCEL" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Visibility="Collapsed" Click="Cancel_Click"/>
        <Button x:Name="ContinueBtn" Content="CONTINUE  →" Style="{StaticResource PrimaryBtn}" IsEnabled="False" Click="Continue_Click"/>
      </StackPanel>
    </StackPanel>

    <!-- ── Page 2 (own PC): sign up with email ── -->
    <StackPanel x:Name="SignUpPage" Margin="34,30,34,28" Visibility="Collapsed">
      <TextBlock Text="YOUR ACCOUNT" Style="{StaticResource Kicker}"/>
      <TextBlock Text="SIGN IN WITH YOUR EMAIL" Style="{StaticResource StepHeading}" FontSize="38"/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                 Text="SRT emails you a 6-digit code. Already raced with SRT? Use the same email and your laps stay on one profile. Steam must be signed in to your own account."/>

      <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="EmailInput" Style="{StaticResource Field}" Margin="0" MaxLength="254" KeyDown="EmailInput_KeyDown"/>
        <Button x:Name="SendCodeBtn" Grid.Column="1" Content="SEND CODE" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="SendCode_Click"/>
      </Grid>
      <TextBlock x:Name="EmailNotice" Style="{StaticResource Hint}" Margin="0,0,0,14"
                 Text="Your email is only used to verify your identity. We will not use it for anything else."/>
      <Grid x:Name="DiscordSignInRow" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                   Text="Or sign in with Discord instead of email. Raced with SRT on Discord before? You get your existing profile."/>
        <Button Grid.Column="1" Content="SIGN IN WITH DISCORD" Style="{StaticResource SecondaryBtn}" Margin="12,0,0,0" Click="DiscordSignIn_Click"/>
      </Grid>

      <StackPanel x:Name="CodePanel" Visibility="Collapsed">
        <TextBlock Text="6-DIGIT CODE FROM THE EMAIL" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="CodeInput" Style="{StaticResource Field}" Margin="0,0,0,6" MaxLength="7" KeyDown="CodeInput_KeyDown"/>
        <TextBlock x:Name="CodeStatus" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
      </StackPanel>

      <StackPanel x:Name="NamePanel" Visibility="Collapsed">
        <TextBlock Text="NAME ON THE LEADERBOARD" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameInput" Style="{StaticResource Field}" Margin="0,0,0,6" MaxLength="64" KeyDown="CodeInput_KeyDown"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14" Text="First time with this email. Choose the name shown on SRT leaderboards."/>
      </StackPanel>

      <TextBlock x:Name="SignUpStatus" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,0,0,12"/>
      <TextBlock x:Name="SignUpError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="←  BACK" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="Back_Click"/>
        <Button x:Name="VerifyBtn" Content="SIGN IN" Style="{StaticResource PrimaryBtn}" IsEnabled="False" Click="Verify_Click"/>
      </StackPanel>
    </StackPanel>

    <!-- ── Page 3 (own PC, after email sign-in): link Discord, optional ── -->
    <StackPanel x:Name="LinkPage" Margin="34,30,34,28" Visibility="Collapsed">
      <TextBlock Text="ONE MORE THING (OPTIONAL)" Style="{StaticResource Kicker}"/>
      <TextBlock Text="LINK YOUR DISCORD" Style="{StaticResource StepHeading}" FontSize="38"/>
      <TextBlock x:Name="LinkIntro" Style="{StaticResource Hint}" Margin="0,0,0,20"
                 Text="Link your Discord to your SRT driver profile. You can then sign in with Discord instead of email, and if you've raced in SRT's online events, that history joins your sim centre and home laps on one profile. Once it's linked, you can join the SRT Discord server."/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="SKIP FOR NOW" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="SkipLink_Click"/>
        <Button Content="LINK DISCORD" Style="{StaticResource PrimaryBtn}" Click="LinkDiscord_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</local:PageView>
